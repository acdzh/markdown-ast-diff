{
  "name": "markdown-ast-diff",
  "version": "0.1.1",
  "description": "使用 AST 比较两个 Markdown 文档并生成差异结果的 AST",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "files": [
    "package.json",
    "README.md",
    "src",
    "dist"
  ],
  "scripts": {
    "test": "tsx test/node/index.ts",
    "dev": "vite ./test/browser",
    "build": "tsup",
    "build:preview": "vite build ./test/browser --outDir output",
    "lint": "eslint --ext .ts,.tsx src/ test/",
    "lint:fix": "eslint --ext .ts,.tsx src/ test/ --fix"
  },
  "keywords": [
    "markdown",
    "diff",
    "ast",
    "lowdown"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@datastructures-js/priority-queue": "^6.3.3",
    "diff": "^8.0.2",
    "unist-util-visit": "^5.0.0"
  },
  "devDependencies": {
    "@types/mdast": "^4.0.4",
    "@types/node": "^20.10.0",
    "@types/react": "^18.2.15",
    "@types/react-dom": "^18.2.7",
    "@types/unist": "^3.0.3",
    "@vitejs/plugin-react": "^4.2.1",
    "assert": "^2.1.0",
    "eslint": "^9.31.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-stringify": "^11.0.0",
    "tsup": "^9.0.0",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.37.0",
    "unified": "^11.0.5",
    "unist-builder": "^4.0.0",
    "vite": "^5.0.10",
    "vite-plugin-node-polyfills": "^0.24.0"
  }
}
